# Public mobile configuration only. Copy to .env.development.local.
# Never put DATABASE_URL, AUTH_ISSUER secrets, service-role keys, or RevenueCat secret here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_NAME=Job to Invoice
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
# Public Auth only. Never put the service-role key, database URL, or JWT secret here.
EXPO_PUBLIC_AUTH_PROJECT_URL=
EXPO_PUBLIC_AUTH_PUBLISHABLE_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
