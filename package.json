{
  "name": "job-to-invoice",
  "private": true,
  "version": "0.0.0",
  "description": "Job to Invoice monorepo — iPhone operator app, customer portal, and Fastify domain API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev -w @job-to-invoice/api",
    "dev:worker": "npm run dev -w @job-to-invoice/worker",
    "dev:portal": "npm run dev -w @job-to-invoice/portal",
    "dev:admin": "npm run dev -w @job-to-invoice/admin",
    "dev:mobile": "npm run start -w @job-to-invoice/mobile",
    "supabase": "supabase",
    "db:push:dev": "node scripts/db-push-development.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.2",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "eslint": "^9.35.0",
    "expo-router": "5.1.11",
    "supabase": "2.117.0",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0"
  }
}
