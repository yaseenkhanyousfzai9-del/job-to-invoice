# Copy to .env.development.local (gitignored). Never commit real secrets.
# Use the DEVELOPMENT Supabase project only. Do not paste production values.

APP_ENV=development
PUBLIC_APP_NAME=Job to Invoice

API_BASE_URL=http://localhost:3001
API_PORT=3001
PORTAL_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002

# Public Auth (mobile/portal may use these later; never put service-role keys here)
# AUTH_PROJECT_URL=https://<development-project-ref>.supabase.co
AUTH_PROJECT_URL=
AUTH_PUBLISHABLE_KEY=

# Server-only Auth verification (apps/api, apps/worker). Never ship in mobile.
# AUTH_ISSUER=<AUTH_PROJECT_URL>/auth/v1
# AUTH_JWKS_URL=<AUTH_PROJECT_URL>/auth/v1/.well-known/jwks.json
AUTH_ISSUER=
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=

# Server-only database. Never ship in mobile or public browser bundles.
# DATABASE_URL_API must use app_api_login (not postgres, not superuser, not BYPASSRLS).
# DATABASE_URL_MIGRATIONS is the migration role only. See supabase/README.md.
DATABASE_URL_API=
DATABASE_URL_MIGRATIONS=

STORAGE_SERVICE_KEY=

REVENUECAT_PUBLIC_IOS_KEY=
REVENUECAT_SECRET_KEY=

EMAIL_API_KEY=
EMAIL_WEBHOOK_SECRET=

ERROR_REPORTING_DSN=
